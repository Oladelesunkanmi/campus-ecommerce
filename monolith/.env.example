# WORKERS=2: one Uvicorn worker per CPU of the 2-CPU app budget
WORKERS=2
# LOG_LEVEL=warning: Uvicorn requires lowercase; WARNING keeps logs quiet during runs
LOG_LEVEL=warning
DATABASE_URL=postgresql+asyncpg://campus:campus@db:5432/campus
# BCRYPT_ROUNDS=10: fairness setting, identical in both systems
BCRYPT_ROUNDS=10
# DB pool: 5 size + 5 overflow per process, 30s timeout
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# JWT_EXPIRY_MINUTES=60: tokens must not expire during a test run
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MINUTES=60
# PAYMENT_DELAY_MS=50: simulated payment delay
PAYMENT_DELAY_MS=50